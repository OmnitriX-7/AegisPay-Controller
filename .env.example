# ==============================================================================
# AegisPay-Controller Environment Configuration
# Track 04: AI Finance Controller - Razorpay AI Buildathon 2026
# ==============================================================================

# Server Port & Host
PORT=8000
HOST=0.0.0.0

# Environment Mode: development / staging / production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection URL (Default: Zero-setup local SQLite database)
DATABASE_URL=sqlite:///./data/aegispay.db

# Optional: Google Gemini API Key for Live CFO Generative AI Reasoning
# Get a free key at: https://aistudio.google.com/app/apikey
# If left blank, the system automatically uses the high-precision deterministic invariant solver!
GEMINI_API_KEY=

# Optional: Razorpay Webhook Secret for HMAC-SHA256 Signature Verification
RAZORPAY_WEBHOOK_SECRET=whsec_aegispay_buildathon_2026

# Prometheus Telemetry Scrape Interval
PROMETHEUS_SCRAPE_INTERVAL=5s
