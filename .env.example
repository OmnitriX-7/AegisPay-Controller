# ==============================================================================
# AegisPay-Controller Environment Configuration
# ==============================================================================

# Server Port
PORT=8000

# Environment Mode: development / staging / production
ENVIRONMENT=development

# Database Connection URL
# Option 1 (Default): Zero-setup local SQLite database
DATABASE_URL=sqlite:///./aegispay.db

# Option 2: Supabase / PostgreSQL Cloud Database
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Optional: Prometheus Telemetry Scrape Interval
PROMETHEUS_SCRAPE_INTERVAL=5s
